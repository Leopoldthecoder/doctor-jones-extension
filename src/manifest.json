{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "homepage_url": "https://leopoldthecoder.github.io/doctor-jones/",
  "description": "中文排版格式化工具",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content_scripts/index.ts"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png",
      "724": "icons/724.png"
    }
  }
}
